# ==============================================================================
# QA Automation Engine & Testing Framework - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and update the values for your target test environment.
# Never commit real credentials or production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Target Application & Test Credentials
# ------------------------------------------------------------------------------
TARGET_URL=https://www.saucedemo.com
TEST_USER=standard_user
TEST_PASS=secret_sauce

# ------------------------------------------------------------------------------
# UI Selectors / Locators (Optional overrides for target application)
# ------------------------------------------------------------------------------
USER_LOCATOR=#user-name
PASS_LOCATOR=#password
LOGIN_LOCATOR=#login-button

# ------------------------------------------------------------------------------
# Playwright Test Execution Controls
# ------------------------------------------------------------------------------
# Supported browser engines: chromium, firefox, webkit
BROWSER=chromium
# Run browser in headless mode: true or false
HEADLESS=true
# Global step timeout in milliseconds
TIMEOUT=10000

# ------------------------------------------------------------------------------
# API Health & SLA Benchmarking
# ------------------------------------------------------------------------------
API_EXPECTED_STATUS=200
API_SLA_MS=3000

# ------------------------------------------------------------------------------
# Web Dashboard / Flask Security
# ------------------------------------------------------------------------------
# Secret key for signing session cookies (generate a secure random 32+ char key)
SECRET_KEY=dev-secret-change-in-production-random-hex-string
SESSION_TIMEOUT_MINUTES=30
ADMIN_DEFAULT_EMAIL=admin@test.com
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=AdminPassword123!Secure

# ------------------------------------------------------------------------------
# SMTP Verification & Notification Service (Optional)
# ------------------------------------------------------------------------------
# If left empty, the engine falls back to simulated console mock delivery
SMTP_EMAIL=your-service-account@gmail.com
SMTP_PASSWORD=your-app-specific-password

# ------------------------------------------------------------------------------
# Security Wordlists (Comma-separated override, or leave blank to use defaults)
# ------------------------------------------------------------------------------
WORDLIST_USERS=
WORDLIST_PASSES=
